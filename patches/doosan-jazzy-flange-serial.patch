+//----- Tool flange serial service callbacks -----------------------------------------------
+auto flange_serial_open_cb = [this](
+    const std::shared_ptr<dsr_msgs2::srv::FlangeSerialOpen::Request> req,
+    std::shared_ptr<dsr_msgs2::srv::FlangeSerialOpen::Response> res) -> void
+{
+    res->success = false;
+    if (g_bIsEmulatorMode) {
+        RCLCPP_WARN(rclcpp::get_logger("dsr_controller2"),
+                    "flange_serial_open is not available in emulator mode");
+        return;
+    }
+
+    const int baudrate = req->baudrate > 0 ? req->baudrate : 115200;
+    const BYTE_SIZE bytesize = req->bytesize == 5 ? BYTE_SIZE_FIVEBITES :
+                               req->bytesize == 6 ? BYTE_SIZE_SIXBITS :
+                               req->bytesize == 7 ? BYTE_SIZE_SEVENBITS : BYTE_SIZE_EIGHTBITS;
+    const PARITY_CHECK parity = req->parity == 1 ? PARITY_CHECK_ODD :
+                                req->parity == 2 ? PARITY_CHECK_EVEN : PARITY_CHECK_NONE;
+    const STOP_BITS stopbits = req->stopbits == 2 ? STOPBITS_TWO : STOPBITS_ONE;
+    res->success = Drfl->flange_serial_open(req->port, baudrate, bytesize, parity, stopbits);
+};
+
+auto flange_serial_close_cb = [this](
+    const std::shared_ptr<dsr_msgs2::srv::FlangeSerialClose::Request> req,
+    std::shared_ptr<dsr_msgs2::srv::FlangeSerialClose::Response> res) -> void
+{
+    res->success = false;
+    if (g_bIsEmulatorMode) {
+        RCLCPP_WARN(rclcpp::get_logger("dsr_controller2"),
+                    "flange_serial_close is not available in emulator mode");
+        return;
+    }
+    res->success = Drfl->flange_serial_close(req->port);
+};
+
+auto flange_serial_write_cb = [this](
+    const std::shared_ptr<dsr_msgs2::srv::FlangeSerialWrite::Request> req,
+    std::shared_ptr<dsr_msgs2::srv::FlangeSerialWrite::Response> res) -> void
+{
+    res->success = false;
+    if (g_bIsEmulatorMode) {
+        RCLCPP_WARN(rclcpp::get_logger("dsr_controller2"),
+                    "flange_serial_write is not available in emulator mode");
+        return;
+    }
+
+    const int port = req->port > 0 ? req->port : 1;
+    std::vector<char> data(req->data.begin(), req->data.end());
+    res->success = Drfl->flange_serial_write(
+        static_cast<int>(data.size()), data.data(), port);
+};
+
+auto flange_serial_read_cb = [this](
+    const std::shared_ptr<dsr_msgs2::srv::FlangeSerialRead::Request> req,
+    std::shared_ptr<dsr_msgs2::srv::FlangeSerialRead::Response> res) -> void
+{
+    res->success = false;
+    res->size = 0;
+    if (g_bIsEmulatorMode) {
+        RCLCPP_WARN(rclcpp::get_logger("dsr_controller2"),
+                    "flange_serial_read is not available in emulator mode");
+        return;
+    }
+
+    const int port = req->port > 0 ? req->port : 1;
+    const LPFLANGE_SER_RXD_INFO_EX info = Drfl->flange_serial_read(req->timeout, port);
+    if (info != nullptr && info->_iSize > 0) {
+        res->size = info->_iSize;
+        res->data.resize(info->_iSize);
+        for (int i = 0; i < info->_iSize; ++i) {
+            res->data[i] = static_cast<uint8_t>(info->_cRxd[i]);
+        }
+    }
+    res->success = info != nullptr;
+};
